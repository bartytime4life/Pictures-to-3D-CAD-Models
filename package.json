{
  "name": "pictures-to-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite frontend --config frontend/vite.config.ts",
    "build": "tsc -p frontend/tsconfig.json && vite build frontend --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/start.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
